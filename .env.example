# ==============================================================================
# TerraSpectra — Monorepo Environment Configuration Template
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=terraspectra
POSTGRES_PASSWORD=terraspectra_secret_pass
POSTGRES_DB=terraspectra
POSTGRES_PORT=5432

# Redis Cache & Background Task Queue
REDIS_PORT=6379

# FastAPI Backend Service (prefix: TS_)
TS_ENV=production
TS_DATABASE_URL=postgresql+psycopg://terraspectra:terraspectra_secret_pass@postgres:5432/terraspectra
TS_REDIS_URL=redis://redis:6379/0
TS_STORAGE_DIR=/data
TS_MODEL_PATH=/models/model.pt
TS_DEVICE=auto
TS_API_KEYS=dev-key-change-me,demo-token-terraspectra-2026
TS_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
TS_LOG_LEVEL=INFO
TS_QUEUE_MODE=rq
TS_QUEUE_NAME=terraspectra
TS_BATCH_SIZE=32
TS_HOST=0.0.0.0
TS_PORT=8000

# React GIS 3D Dashboard (Vite)
VITE_API_URL=http://localhost:8000
VITE_API_KEY=dev-key-change-me
